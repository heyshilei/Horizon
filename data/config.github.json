{
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api_key_env": "GOOGLE_API_KEY",
    "throttle_sec": 4.2,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["en", "zh"]
  },
  "collection": {
    "time_window_hours": 48
  },
  "sources": {
    "twitter": {
      "enabled": true,
      "users": [
        "OpenAI",
        "AnthropicAI",
        "GoogleDeepMind",
        "xai",
        "deepseek_ai",
        "sama",
        "karpathy",
        "elonmusk",
        "VitalikButerin",
        "aixbt_agent",
        "0xLuxi",
        "xi99ol"
      ],
      "keywords": [
        "(Claude OR Gemini OR DeepSeek OR GPT OR OpenAI OR Grok) min_faves:20 -filter:replies lang:en",
        "(Bitcoin OR BTC OR Solana OR Ethereum OR Crypto) min_faves:20 -filter:replies lang:en"
      ],
      "fetch_limit": 100,
      "category": "x-top",
      "profile": "ai-creator",
      "fetch_reply_text": true,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 3,
      "reply_min_likes": 5
    },
    "reddit": {
      "enabled": true,
      "fetch_comments": 5,
      "subreddits": [
        { "subreddit": "LocalLLaMA", "sort": "top", "fetch_limit": 12, "min_score": 20, "category": "reddit-top", "profile": "ai-creator" },
        { "subreddit": "singularity", "sort": "top", "fetch_limit": 12, "min_score": 20, "category": "reddit-top", "profile": "ai-creator" },
        { "subreddit": "ClaudeAI", "sort": "top", "fetch_limit": 10, "min_score": 20, "category": "reddit-top", "profile": "ai-creator" },
        { "subreddit": "OpenAI", "sort": "top", "fetch_limit": 10, "min_score": 20, "category": "reddit-top", "profile": "ai-creator" },
        { "subreddit": "CryptoCurrency", "sort": "top", "fetch_limit": 12, "min_score": 20, "category": "reddit-top", "profile": "ai-creator" },
        { "subreddit": "solana", "sort": "top", "fetch_limit": 8, "min_score": 20, "category": "reddit-top", "profile": "ai-creator" }
      ]
    },
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 25,
      "min_score": 20,
      "category": "other-top",
      "profile": "ai-creator"
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript"],
      "min_stars": 20,
      "max_items": 12,
      "category": "other-top",
      "profile": "ai-creator"
    },
    "github": [
      { "type": "repo_releases", "owner": "ollama", "repo": "ollama", "enabled": true, "category": "other-top", "profile": "ai-creator" },
      { "type": "repo_releases", "owner": "deepseek-ai", "repo": "DeepSeek-V3", "enabled": true, "category": "other-top", "profile": "ai-creator" },
      { "type": "repo_releases", "owner": "vllm-project", "repo": "vllm", "enabled": true, "category": "other-top", "profile": "ai-creator" }
    ],
    "telegram": {
      "enabled": true,
      "channels": [
        { "channel": "watcher_guru", "enabled": true, "fetch_limit": 12, "category": "other-top", "profile": "ai-creator" },
        { "channel": "cointelegraph", "enabled": true, "fetch_limit": 12, "category": "other-top", "profile": "ai-creator" },
        { "channel": "zaihuapd", "enabled": true, "fetch_limit": 12, "category": "other-top", "profile": "ai-creator" }
      ]
    },
    "rss": [
      { "name": "OpenAI News", "url": "https://openai.com/news/rss.xml", "enabled": true, "category": "other-top", "profile": "ai-creator" },
      { "name": "Google DeepMind Blog", "url": "https://deepmind.google/blog/rss.xml", "enabled": true, "category": "other-top", "profile": "ai-creator" },
      { "name": "Hugging Face Blog", "url": "https://huggingface.co/blog/feed.xml", "enabled": true, "category": "other-top", "profile": "ai-creator" },
      { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "other-top", "profile": "ai-creator" },
      { "name": "CoinDesk", "url": "https://www.coindesk.com/arc/outboundfeeds/rss/", "enabled": true, "category": "other-top", "profile": "ai-creator" },
      { "name": "Cointelegraph", "url": "https://cointelegraph.com/rss", "enabled": true, "category": "other-top", "profile": "ai-creator" }
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-creator",
    "profile_settings": {
      "ai-creator": { "threshold": null, "topic_dedup": true },
      "tech-news": { "threshold": null, "topic_dedup": true }
    }
  },
  "digest": {
    "max_items": 30,
    "category_groups": {
      "x_viral": {
        "name": "X / Twitter Top",
        "limit": 8,
        "categories": ["x-top"]
      },
      "reddit_viral": {
        "name": "Reddit Top",
        "limit": 8,
        "categories": ["reddit-top"]
      },
      "other_platforms": {
        "name": "Other Platforms Top",
        "limit": 14,
        "categories": ["other-top"]
      }
    },
    "default_group": "other",
    "default_group_limit": 5
  }
}
