{
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api_key_env": "GOOGLE_API_KEY",
    "throttle_sec": 4.8,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["zh"]
  },
  "collection": {
    "time_window_hours": 48
  },
  "sources": {
    "twitter": {
      "enabled": false
    },
    "reddit": {
      "enabled": false,
      "subreddits": []
    },
    "hackernews": {
      "enabled": false
    },
    "ossinsight": {
      "enabled": false
    },
    "github": [],
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "rss": [
      {
        "name": "X Viral Top 5",
        "url": "https://x-viral.local/feed.xml",
        "enabled": true,
        "category": "x-top",
        "profile": "ai-creator"
      },
      {
        "name": "Reddit Viral Top 10",
        "url": "https://reddit-viral.local/feed.xml",
        "enabled": true,
        "category": "reddit-top",
        "profile": "ai-creator"
      }
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-creator",
    "profile_settings": {
      "ai-creator": { "threshold": 5.5, "topic_dedup": true }
    }
  },
  "digest": {
    "max_items": 15,
    "category_groups": {
      "x_viral": {
        "name": "X (Twitter) 48h Top 5",
        "limit": 5,
        "categories": ["x-top"]
      },
      "reddit_viral": {
        "name": "Reddit 24h Top 10 (1000+ Votes & 100+ Comments)",
        "limit": 10,
        "categories": ["reddit-top"]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  }
}
