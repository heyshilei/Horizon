{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.5-flash-lite",
    "api_key_env": "GOOGLE_API_KEY",
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["en", "zh"]
  },
  "collection": {
    "time_window_hours": 24
  },
  "sources": {
    "twitter": {
      "enabled": true,
      "users": [
        "karpathy",
        "sama",
        "VitalikButerin",
        "levelsio",
        "rauchg",
        "garrytan"
      ],
      "keywords": [
        "(\"AI agent\" OR \"Claude\" OR \"GPT\" OR \"Gemini\" OR \"LLM\") min_faves:400 min_retweets:30 -filter:replies lang:en",
        "(\"Bitcoin\" OR \"Solana\" OR \"crypto\" OR \"Ethereum\") min_faves:500 min_retweets:40 -filter:replies lang:en"
      ],
      "fetch_limit": 80,
      "category": "x-hot",
      "fetch_reply_text": false
    },
    "reddit": {
      "enabled": true,
      "fetch_comments": 0,
      "subreddits": [
        { "subreddit": "singularity", "sort": "hot", "fetch_limit": 30, "min_score": 100, "category": "ai-hot" },
        { "subreddit": "LocalLLaMA", "sort": "hot", "fetch_limit": 30, "min_score": 50, "category": "ai-hot" },
        { "subreddit": "CryptoCurrency", "sort": "hot", "fetch_limit": 30, "min_score": 100, "category": "crypto-hot" }
      ]
    },
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 40,
      "min_score": 120,
      "category": "ai-hot"
    },
    "rss": [
      { "name": "OpenAI News", "url": "https://openai.com/news/rss.xml", "enabled": true, "category": "ai-hot" },
      { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ai-hot" },
      { "name": "CoinDesk", "url": "https://www.coindesk.com/arc/outboundfeeds/rss/", "enabled": true, "category": "crypto-hot" }
    ]
  },
  "processing": {
    "default_profile": "ai-creator",
    "profile_settings": {
      "ai-creator": { "threshold": 7.0, "topic_dedup": true }
    }
  },
  "digest": {
    "max_items": 12,
    "category_groups": {
      "x_viral": { "name": "X Viral Trends", "limit": 4, "categories": ["x-hot"] },
      "ai_ecosys": { "name": "AI & Open Source", "limit": 5, "categories": ["ai-hot"] },
      "crypto_mkt": { "name": "Crypto & Web3", "limit": 3, "categories": ["crypto-hot"] }
    }
  }
}
