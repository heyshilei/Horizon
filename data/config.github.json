{
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api_key_env": "GOOGLE_API_KEY",
    "languages": ["zh", "en"],
    "throttle_sec": 4.5,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "collection": {
    "time_window_hours": 24
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-creator",
    "profile_settings": {
      "ai-creator": {
        "threshold": null,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "twitter": {
      "enabled": true,
      "users": [
        "sama",
        "karpathy",
        "elonmusk",
        "vitalikbuterin",
        "0xLuxi",
        "xi99ol"
      ],
      "keywords": [
        "(AI OR LLM OR OpenAI OR Claude OR Gemini) min_faves:20 -filter:replies",
        "(Bitcoin OR BTC OR Crypto OR Solana OR DeFi) min_faves:20 -filter:replies"
      ],
      "fetch_limit": 100,
      "category": "social",
      "profile": "ai-creator",
      "fetch_reply_text": true,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 2,
      "reply_min_likes": 5
    },
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 40,
      "min_score": 20,
      "category": "tech",
      "profile": "ai-creator"
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript"],
      "keywords": [],
      "min_stars": 20,
      "max_items": 30,
      "category": "oss-trending",
      "profile": "ai-creator"
    },
    "reddit": {
      "enabled": true,
      "fetch_comments": 5,
      "subreddits": [
        {
          "subreddit": "singularity",
          "sort": "hot",
          "fetch_limit": 20,
          "min_score": 20,
          "category": "ai-ml",
          "profile": "ai-creator"
        },
        {
          "subreddit": "LocalLLaMA",
          "sort": "hot",
          "fetch_limit": 20,
          "min_score": 20,
          "category": "ai-ml",
          "profile": "ai-creator"
        },
        {
          "subreddit": "MachineLearning",
          "sort": "hot",
          "fetch_limit": 20,
          "min_score": 20,
          "category": "ai-ml",
          "profile": "ai-creator"
        },
        {
          "subreddit": "CryptoCurrency",
          "sort": "hot",
          "fetch_limit": 20,
          "min_score": 20,
          "category": "crypto",
          "profile": "ai-creator"
        }
      ]
    },
    "github": [
      {
        "type": "repo_releases",
        "owner": "ollama",
        "repo": "ollama",
        "enabled": true,
        "category": "oss",
        "profile": "ai-creator"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "oss",
        "profile": "ai-creator"
      }
    ],
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "category": "ai-news",
          "profile": "ai-creator"
        }
      ]
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "ai-news",
        "profile": "ai-creator"
      },
      {
        "name": "Google DeepMind Blog",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "ai-news",
        "profile": "ai-creator"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai-news",
        "profile": "ai-creator"
      },
      {
        "name": "Simon Willison Weblog",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-news",
        "profile": "ai-creator"
      },
      {
        "name": "Cointelegraph",
        "url": "https://cointelegraph.com/rss",
        "enabled": true,
        "category": "finance",
        "profile": "ai-creator"
      },
      {
        "name": "CoinDesk",
        "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
        "enabled": true,
        "category": "finance",
        "profile": "ai-creator"
      }
    ]
  },
  "digest": {
    "max_items": 15,
    "category_groups": {
      "twitter": {
        "name": "X / Twitter",
        "limit": 5,
        "categories": ["social"]
      },
      "tech_oss": {
        "name": "Hacker News & GitHub",
        "limit": 4,
        "categories": ["tech", "oss", "oss-trending"]
      },
      "reddit": {
        "name": "Reddit",
        "limit": 3,
        "categories": ["ai-ml", "crypto"]
      },
      "news": {
        "name": "AI & Crypto News",
        "limit": 3,
        "categories": ["ai-news", "finance"]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "email": {
    "enabled": false
  },
  "webhook": {
    "enabled": false
  },
  "wechat": {
    "enabled": false
  }
}
